
ns = {
	'id':params_kw['id'],
}


db = DBPools()
dbname = get_module_dbname('llm')
async with db.sqlorContext(dbname) as sor:
	r = await sor.D('llmusage_history', ns)
	debug('delete success');
	return {
		"widgettype":"Message",
		"options":{
			"title":"Delete Success",
			"timeout":3,
			"cwidth":16,
			"cheight":9,
			"message":"ok"
		}
	}

debug('Delete failed');
return {
	"widgettype":"Error",
	"options":{
		"title":"Delete Error",
		"timeout":3,
		"cwidth":16,
		"cheight":9,
		"message":"failed"
	}
}