# KTV Media API - demucs-separate
# /v1/media/demucs-separate

debug_params('params_kw', params_kw)

userid = await get_user()
userorgid = await get_userorgid()
if userid is None:
	return openai_403()

catelogid = 'ktv_pipeline'
model_name = 'demucs-separate'
params_kw.model = model_name
params_kw.catelogid = catelogid

env = request._run_ns
# llmid from cache (model+catelogid -> llmid)
llmid = await env.get_llmid_cached(env, params_kw.model, catelogid)
if not llmid:
	debug(f'model not found: {params_kw.model}')
	return openai_400()
params_kw.llmid = llmid
params_kw.llmcatelogid = catelogid

f = await checkCustomerBalance(params_kw.llmid, userid, userorgid)
if not f:
	return openai_429()

return await inference(request, env=env)
