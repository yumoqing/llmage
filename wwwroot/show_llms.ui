{% set catelogs = get_llmcatelogs() %}
{
	"widgettype":"HBox",
	"options":{
		"width":"100%",
		"height":"100%"
	},
	"subwidgets":[
		{
			"widgettype":"VScrollPanel",
			"options":{
				"cwidth":18,
				"height":"100%",
				"css":"plaza-sidebar"
			},
			"subwidgets":[
				{
					"widgettype":"Button",
					"options":{
						"label":"全部",
						"css":"plaza-nav-btn",
						"width":"100%"
					},
					"binds":[
						{
							"wid":"self",
							"event":"click",
							"actiontype":"urlwidget",
							"target":"plaza_cards_panel",
							"options":{
								"url":"{{entire_url('show_llms_cards.ui')}}"
							}
						}
					]
				},
{% for cat in catelogs %}
				{
					"widgettype":"Button",
					"options":{
						"label":"{{cat.name}}",
						"css":"plaza-nav-btn",
						"width":"100%"
					},
					"binds":[
						{
							"wid":"self",
							"event":"click",
							"actiontype":"urlwidget",
							"target":"plaza_cards_panel",
							"options":{
								"url":"{{entire_url('show_llms_cards.ui')}}",
								"params":{
									"catelogid":"{{cat.id}}"
								}
							}
						}
					]
				}{% if not loop.last %},{% endif %}
{% endfor %}
			]
		},
		{
			"widgettype":"urlwidget",
			"id":"plaza_cards_panel",
			"options":{
				"cwidth":82,
				"height":"100%",
				"url":"{{entire_url('show_llms_cards.ui')}}"
			}
		}
	]
}
