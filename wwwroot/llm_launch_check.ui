{% if params_kw.id %}
{% set llmid = params_kw.id %}
{
	"widgettype": "VBox",
	"options": {
		"width": "100%",
		"height": "100%",
		"spacing": 10
	},
	"subwidgets": [
		{
			"widgettype": "Title",
			"options": {
				"text": "模型上线检查",
				"level": 2
			}
		},
		{
			"widgettype": "Text",
			"options": {
				"name": "check_status",
				"text": "检查中...",
				"i18n": false
			}
		},
		{
			"widgettype": "VBox",
			"options": {
				"name": "checks_list",
				"spacing": 5
			}
		},
		{
			"widgettype": "Button",
			"options": {
				"name": "test_btn",
				"text": "体验一次",
				"i18n": false,
				"disabled": true
			}
		},
		{
			"widgettype": "Text",
			"options": {
				"name": "test_result",
				"text": "",
				"i18n": false
			}
		},
		{
			"widgettype": "Button",
			"options": {
				"name": "check_charging_btn",
				"text": "检查计费",
				"i18n": false,
				"disabled": true
			}
		},
		{
			"widgettype": "Text",
			"options": {
				"name": "charging_result",
				"text": "",
				"i18n": false
			}
		}
	],
}
{% else %}
{
	"widgettype": "Text",
	"options": {
		"text": "缺少模型ID参数",
		"i18n": true
	}
}
{% endif %}
