userid = await get_user()
userorgid = await get_userorgid()

if userid is None:
	return openai_403

if params_kw.llmid is None:
	return openai_400()

f = await checkCustomerBalance(params_kw.llmid, userorgid)
if not f:
    return openai_429()

env = request._run_ns
return await inference(request, env=env)

