{
    "tblname": "llm_api_map",
    "title": "模型能力映射",
    "params": {
        "browserfields": {
            "exclouded": ["id", "llmid"],
            "alters": {
                "apiname": {
                    "uitype": "code",
                    "dataurl": "{{entire_url('../api/get_search_apiname.dspy')}}?llmid={{params_kw.llmid}}",
                    "valueField": "apiname",
                    "textField": "apiname_text"
                },
                "query_apiname": {
                    "uitype": "code",
                    "dataurl": "{{entire_url('../api/get_search_apiname.dspy')}}?allow_empty=1&llmid={{params_kw.llmid}}",
                    "valueField": "apiname",
                    "textField": "apiname_text"
                },
                "isdefaultcatelog": {
                    "uitype": "code",
                    "data": [
                        {"value": "0", "text": "否"},
                        {"value": "1", "text": "是"}
                    ]
                }
            }
        },
        "editexclouded": ["id", "llmid"]
    }
}
